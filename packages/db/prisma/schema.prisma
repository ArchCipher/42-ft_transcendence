generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================================
// ENUMS
// ==========================================================================
enum OrgRole {
  USER
  ADMIN
}

enum DocRole {
  EDITOR
  VIEWER
}

// ==========================================================================
// MODELS
// ==========================================================================
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String?   // null = OAuth-only account
  role              OrgRole   @default(USER)  // global role (USER/ADMIN) => TBD : do we want to keep that ?
  avatarUrl         String?   // null = show default avatar
  lastSeenAt        DateTime? // for "online status" // RGPD: Inform the user about storing this data
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  sessions                Session[]                 @relation("UserSession")
  emailVerificationTokens EmailVerificationToken[]  @relation("UserEmailVerification")
  passwordResetTokens     PasswordResetToken[]      @relation("UserPasswordReset")
  ownedDocuments          Document[]                @relation("DocumentOwner")
  collabDocuments         DocumentShare[]           @relation("Collaborator")
}

model Document {
  id        String   @id @default(cuid())
  title     String
  ystate    Bytes?   // Stores the state of the doc for collaboration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A document belongs either to a registered user or to a temporary guest
  // session. The database migration enforces that exactly one is present.
  ownerId        String?
  owner          User?         @relation("DocumentOwner", fields: [ownerId], references: [id])
  guestSessionId String?       @unique
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)

  // Collaboration relation
  collab    DocumentShare[] @relation("Collaborator")
  snapshots DocumentSnapshot[]
}

model DocumentSnapshot {
  id         String   @id @default(cuid())
  documentId String
  ystate     Bytes
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

model GuestSession {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  editExpiresAt DateTime
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  document      Document?

  @@index([expiresAt])
  @@index([editExpiresAt])
}

model DocumentShare {
  id          String   @id @default(cuid())
  docRole     DocRole @default(VIEWER)
  userId      String
  documentId  String
  user        User     @relation("Collaborator", fields: [userId], references: [id], onDelete: Cascade)
  document    Document @relation("Collaborator",fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation("UserSession", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  ip         String?   // RGPD: Inform the user about storing this data
  userAgent  String?   // RGPD: Inform the user about storing this data
  createdAt  DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserEmailVerification", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserPasswordReset", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}
