DOMAIN_NAME=localhost

# Non-secrets only; passwords live in secrets/
# DB_PASSWORD is injected via Docker secret for postgres;
# if the app needs it in env for DATABASE_URL, load from secret file in entrypoint.
# Change value of NODE_ENV
NODE_ENV=development

# POSTGRES (password in secrets/db_password.txt)
# Change values of DB_NAME and DB_USER
DB_NAME=synctext
DB_USER=synctext