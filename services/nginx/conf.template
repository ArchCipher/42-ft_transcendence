# Nginx configuration file for a static HTML server on port 443

# HTTPS Server
server {
  listen         443 ssl;
  server_tokens  off;
  server_name    ${DOMAIN_NAME}; # target subdomain

  # SSL configuration
  ssl_certificate /run/secrets/server_certificate;  # certificate location
  ssl_certificate_key /run/secrets/server_key;  # certificate key location
  ssl_protocols TLSv1.2 TLSv1.3; # accept connections with TLSv1.2 or TLSv1.3

  # Frontend
  location / {
    proxy_pass http://frontend:80;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Backend API
  location /api/ {
    proxy_pass http://backend:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # WebSockets
  location /ws/ {
    proxy_pass http://backend:3000/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }
}
