# https entry point for the application

server {
    listen 443 ssl;
    server_tokens off;
    server_name ${DOMAIN_NAME};

    # tls certificate and private key
    ssl_certificate /run/secrets/server_certificate;
    ssl_certificate_key /run/secrets/server_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # forward application traffic to next.js
    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # overwrite (not append) so client-IP can't be spoofed
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
