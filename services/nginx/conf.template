# https entry point for the application

# this file is dropped into /etc/nginx/templates/, which nginx includes
# inside its own http {} block — so a top-level `map` here is already in
# http context, no need (and no way) to open one ourselves
map $http_upgrade $connection_upgrade {
    websocket upgrade;
    default   close;
}

server {
    listen 443 ssl;
    server_tokens off;
    server_name ${DOMAIN_NAME};

    # tls certificate and private key
    ssl_certificate /run/secrets/server_certificate;
    ssl_certificate_key /run/secrets/server_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # forward application traffic to next.js
    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # forward realtime collaboration traffic to the hocuspocus websocket server
    location /collab {
        proxy_pass http://collab:1234;
        proxy_http_version 1.1;

        # switch this connection from HTTP to the WebSocket protocol
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # a websocket connection is long-lived, not a single request/response —
        # the default 60s read timeout would silently kill idle editors
        proxy_read_timeout 3600s;

        # buffering delays frames waiting for a full buffer to fill, which
        # defeats realtime sync; stream frames through immediately instead
        proxy_buffering off;
    }

    # minimal static demo client (see services/collab/demo/) — serves whatever
    # is bind-mounted at /usr/share/nginx/html/demo in the nginx service
    location /demo/ {
        root /usr/share/nginx/html;
    }
}
