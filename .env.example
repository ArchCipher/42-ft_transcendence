# public hostname used by nginx and tls
DOMAIN_NAME=localhost

# application environment
NODE_ENV=production

# postgres configuration
DB_NAME=synctext
DB_USER=synctext
DB_PASSWORD=change_me

# collab (hocuspocus) configuration
# not yet enforced — reserved for when onAuthenticate verifies real sessions
COLLAB_JWT_SECRET=change_me
# how long the server waits after the last edit before writing to postgres,
# and the hard cap so a constant stream of edits still gets saved eventually
STORE_DEBOUNCE_MS=2000
STORE_MAX_DEBOUNCE_MS=10000
